---
import BaseLayout from './BaseLayout.astro';
import '@styles/nobo.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, schema = [] } = Astro.props;
---

<BaseLayout {title} {description} {canonical} {schema}>
  <div class="min-h-screen bg-[#18181b] text-zinc-50">
    <slot />
  </div>
</BaseLayout>
