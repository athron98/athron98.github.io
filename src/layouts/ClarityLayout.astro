---
import BaseLayout from './BaseLayout.astro';
import '@styles/clarity.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, keywords, schema = [] } = Astro.props;
---

<BaseLayout {title} {description} {canonical} {keywords} {schema}>
  <div class="bg-gradient-to-b from-clarity-50 to-white dark:from-gray-900 dark:to-gray-950">
    <slot />
  </div>
</BaseLayout>
