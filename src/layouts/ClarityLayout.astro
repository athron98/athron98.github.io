---
import BaseLayout from './BaseLayout.astro';
import '@styles/clarity.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, schema = [] } = Astro.props;
---

<BaseLayout {title} {description} {canonical} {schema}>
  <div class="bg-gradient-to-b from-clarity-50 to-white">
    <slot />
  </div>
</BaseLayout>
