---
import { getCollection, render } from 'astro:content';
import ClarityLayout from '@layouts/ClarityLayout.astro';
import DocsNav from '@components/clarity/DocsNav.astro';
import DocsSidebar from '@components/clarity/DocsSidebar.astro';
import { cx } from '@lib/utils';
import { breadcrumbSchema } from '@lib/schema';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = docs.findIndex((d) => d.id === doc.id);
const prev = index > 0 ? docs[index - 1] : undefined;
const next = index >= 0 && index < docs.length - 1 ? docs[index + 1] : undefined;
const hrefFor = (id: string) => `/clarity/docs/${id}/`;

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Clarity', path: '/clarity/' },
    { name: 'Docs', path: '/clarity/docs/' },
    { name: doc.data.title, path: `/clarity/docs/${doc.id}/` },
  ]),
];
---

<ClarityLayout
  title={`${doc.data.title} - Clarity Docs`}
  description={doc.data.description}
  canonical={`/clarity/docs/${doc.id}/`}
  keywords={`${doc.data.title}, Clarity framework, documentation`}
  {schema}
>
  <DocsNav />
  <div class="container flex flex-col gap-10 py-10 lg:flex-row">
    <DocsSidebar />
    <article class="min-w-0 flex-1">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">{doc.data.title}</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">{doc.data.description}</p>
      <div
        class="prose prose-sky mt-8 max-w-none prose-headings:text-gray-900 prose-a:text-clarity-600 dark:prose-invert dark:prose-headings:text-gray-100 dark:prose-a:text-sky-400"
      >
        <Content />
      </div>
      <nav class="mt-12 flex justify-between gap-4 border-t border-clarity-100 pt-6 text-sm dark:border-gray-800" aria-label="Page navigation">
        {
          prev ? (
            <a href={hrefFor(prev.id)} class={cx('text-clarity-600 hover:underline')}>
              ← {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={hrefFor(next.id)} class="text-clarity-600 hover:underline">
              {next.data.title} →
            </a>
          )
        }
      </nav>
    </article>
  </div>
</ClarityLayout>
