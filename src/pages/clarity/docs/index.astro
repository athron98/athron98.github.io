---
import ClarityLayout from '@layouts/ClarityLayout.astro';
import DocsNav from '@components/clarity/DocsNav.astro';
import DocsSidebar from '@components/clarity/DocsSidebar.astro';
import VersionSelector from '@components/clarity/VersionSelector.astro';
---

<ClarityLayout
  title="Clarity Documentation - Guides & API Reference"
  description="Clarity framework documentation: getting started guides, configuration, and API reference for components and hooks."
  canonical="/clarity/docs/"
>
  <DocsNav />
  <div class="container flex flex-col gap-10 py-10 lg:flex-row">
    <DocsSidebar />
    <article class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-clarity-900">Clarity Documentation</h1>
          <p class="mt-3 max-w-2xl text-clarity-800/80">
            Everything you need to build applications with Clarity: guides, configuration, and API reference.
          </p>
        </div>
        <VersionSelector />
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a
          href="/clarity/docs/getting-started/"
          class="rounded-xl border border-clarity-100 bg-clarity-50 p-6 transition hover:border-clarity-300"
        >
          <h2 class="font-semibold text-clarity-900">Getting Started</h2>
          <p class="mt-2 text-sm text-clarity-800/80">Install and run your first project in minutes.</p>
        </a>
        <a
          href="/clarity/docs/configuration/"
          class="rounded-xl border border-clarity-100 bg-clarity-50 p-6 transition hover:border-clarity-300"
        >
          <h2 class="font-semibold text-clarity-900">Configuration</h2>
          <p class="mt-2 text-sm text-clarity-800/80">Adapt the framework behavior to your project's needs.</p>
        </a>
        <a
          href="/clarity/docs/api/components/"
          class="rounded-xl border border-clarity-100 bg-clarity-50 p-6 transition hover:border-clarity-300"
        >
          <h2 class="font-semibold text-clarity-900">API: Components</h2>
          <p class="mt-2 text-sm text-clarity-800/80">Reference for built-in components and their props.</p>
        </a>
        <a
          href="/clarity/docs/api/hooks/"
          class="rounded-xl border border-clarity-100 bg-clarity-50 p-6 transition hover:border-clarity-300"
        >
          <h2 class="font-semibold text-clarity-900">API: Hooks</h2>
          <p class="mt-2 text-sm text-clarity-800/80">Hooks for state, routing, and data fetching.</p>
        </a>
      </div>
    </article>
  </div>
</ClarityLayout>
