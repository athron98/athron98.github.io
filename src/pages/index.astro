---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/hub/HeroSection.astro';
import EcosystemGrid from '@components/hub/EcosystemGrid.astro';
import ProjectSpotlight from '@components/hub/ProjectSpotlight.astro';
import StatsSection from '@components/hub/StatsSection.astro';
import { ECOSYSTEM_DOMAINS } from '@lib/constants';
import { projectList } from '@lib/projects';
import { personSchema, websiteSchema } from '@lib/schema';

const schema = [
  personSchema(
    ECOSYSTEM_DOMAINS.map((d) => d.domain),
    ['Web Development', 'DevOps', 'System Architecture', 'Music Production']
  ),
  websiteSchema(),
];
---

<BaseLayout
  title="Athron98 Ecosystem - Project Hub, Tools & Documentation"
  description="The official hub of the Athron98/BrokenLight ecosystem: developer project showcases, digital music tools, and technical documentation for the community."
  canonical="/"
  keywords="Athron98, BrokenLight, developer tools, music apps, web development, DevOps, snippet manager, guitar tuner"
  {schema}
>
  <HeroSection />

  <section id="projects" class="bg-white py-16 dark:bg-gray-950" aria-labelledby="projects-heading">
    <div class="container">
      <div data-reveal>
        <h2 id="projects-heading" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
          Featured projects
        </h2>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
          Tools built from scratch to solve real problems.
        </p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {projectList.map((project, i) => <ProjectSpotlight project={project} revealDelay={i * 80} />)}
      </div>
    </div>
  </section>

  <StatsSection />
  <EcosystemGrid />
</BaseLayout>
