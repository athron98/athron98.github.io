---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/hub/HeroSection.astro';
import EcosystemGrid from '@components/hub/EcosystemGrid.astro';
import ProjectSpotlight from '@components/hub/ProjectSpotlight.astro';
import StatsSection from '@components/hub/StatsSection.astro';
import { ECOSYSTEM_DOMAINS } from '@lib/constants';
import { projectList } from '@lib/projects';
import { personSchema } from '@lib/schema';

const schema = [
  personSchema(
    ECOSYSTEM_DOMAINS.map((d) => d.domain),
    ['Web Development', 'DevOps', 'System Architecture', 'Music Production']
  ),
];
---

<BaseLayout
  title="Athron98 Ecosystem - Project Hub, Tools & Documentation"
  description="The official hub of the Athron98/BrokenLight ecosystem: developer project showcases, digital music tools, and technical documentation for the community."
  canonical="/"
  {schema}
>
  <HeroSection />

  <section id="projects" class="bg-white py-16" aria-labelledby="projects-heading">
    <div class="container">
      <h2 id="projects-heading" class="text-3xl font-bold tracking-tight text-gray-900">
        Featured projects
      </h2>
      <p class="mt-3 max-w-2xl text-gray-600">
        Tools built from scratch to solve real problems.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {projectList.map((project) => <ProjectSpotlight project={project} />)}
      </div>
    </div>
  </section>

  <StatsSection />
  <EcosystemGrid />
</BaseLayout>
