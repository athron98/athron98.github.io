---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/shared/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for was not found on the Athron98 ecosystem."
  robots="noindex, follow"
>
  <section class="container flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-bold text-sky-600">404</p>
    <h1 class="mt-4 text-3xl font-bold text-gray-900">Page not found</h1>
    <p class="mt-3 max-w-md text-gray-600">
      The page you are looking for may have been moved or never existed.
    </p>
    <div class="mt-8 flex gap-3">
      <Button href="/" variant="primary">Back to Home</Button>
      <Button href="/clarity/docs/" variant="secondary">Open Documentation</Button>
    </div>
  </section>
</BaseLayout>
