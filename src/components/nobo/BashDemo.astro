---
import { projects } from '@lib/projects';
import { ECOSYSTEM_DOMAINS } from '@lib/constants';

const project = projects.nobo;
const anchor =
  ECOSYSTEM_DOMAINS.find((d) => d.domain.includes('nobo'))?.anchorTexts[1] ?? 'developer tool for code snippets';
---

<section class="bg-[#18181b] py-16">
  <div class="container max-w-3xl text-center" data-reveal>
    <h2 class="text-2xl font-bold text-zinc-50">Try Nobo today</h2>
    <p class="mt-2 text-sm text-zinc-400">
      Nobo is a {anchor} that runs on your own infrastructure.
    </p>
    <a
      href={project.url}
      class="mt-6 inline-flex items-center rounded-md bg-amber-400 px-6 py-3 text-base font-semibold text-zinc-900 shadow-glow-amber transition-all duration-200 hover:-translate-y-0.5 hover:bg-amber-300"
    >
      Open Nobo →
    </a>
  </div>
</section>
