---
interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features?: Feature[];
}

const { features = [
  {
    icon: '⌘',
    title: 'Command palette',
    description: 'Access every snippet without touching the mouse — fully keyboard-driven.',
  },
  {
    icon: '🗂️',
    title: 'Organized boards',
    description: 'Group snippets per project or per topic in separate boards.',
  },
  {
    icon: '⏱️',
    title: 'Instant recall',
    description: 'Copy or re-run your favorite commands in seconds.',
  },
  {
    icon: '🔒',
    title: 'Yours to own',
    description: 'Data stays on your own infrastructure, not on third-party clouds.',
  },
] } = Astro.props;
---

<section id="features" class="bg-[#18181b] py-16" aria-labelledby="nobo-features-heading">
  <div class="container">
    <h2 id="nobo-features-heading" class="text-3xl font-bold tracking-tight text-zinc-50">Why Nobo</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        features.map((feature) => (
          <li class="rounded-xl border border-zinc-800 bg-[#27272a] p-6">
            <span class="text-2xl text-amber-400" aria-hidden="true">{feature.icon}</span>
            <h3 class="mt-3 font-semibold text-zinc-50">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{feature.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
