---
import Button from '@components/shared/Button.astro';
---

<section class="relative overflow-hidden bg-[#18181b]">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-24 left-[20%] h-80 w-80 rounded-full bg-amber-500/10 blur-3xl animate-float"></div>
    <div class="absolute bottom-0 right-[15%] h-72 w-72 rounded-full bg-teal-500/10 blur-3xl animate-float-slow"></div>
  </div>
  <div class="container relative flex flex-col items-center py-20 text-center sm:py-28">
    <p data-reveal class="rounded-full border border-zinc-700 px-4 py-1 text-sm font-medium text-zinc-300">
      Snippet Manager for Developers
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 60ms"
      class="mt-6 max-w-3xl bg-gradient-to-r from-amber-300 via-orange-300 to-teal-300 bg-clip-text text-4xl font-bold tracking-tight text-transparent animate-gradient-x sm:text-5xl"
    >
      Nobo — your notes & snippets, organized on boards
    </h1>
    <p data-reveal style="--reveal-delay: 120ms" class="mt-6 max-w-2xl text-lg text-zinc-400">
      Save terminal commands, code snippets, and ideas on tidy boards. Retrieve them in seconds,
      straight from your keyboard.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="#features" variant="primary" size="lg">View Features</Button>
      <Button href="#demo" variant="ghost" size="lg">Try the Demo</Button>
    </div>
  </div>
</section>
