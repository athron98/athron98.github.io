---
import Button from '@components/shared/Button.astro';
---

<section class="bg-[#18181b]">
  <div class="container flex flex-col items-center py-20 text-center sm:py-28">
    <p class="rounded-full border border-zinc-700 px-4 py-1 text-sm font-medium text-zinc-300">
      Snippet Manager for Developers
    </p>
    <h1 class="mt-6 max-w-3xl text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl">
      Nobo — your notes & snippets, organized on boards
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-zinc-400">
      Save terminal commands, code snippets, and ideas on tidy boards. Retrieve them in seconds,
      straight from your keyboard.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="#features" variant="primary" size="lg">View Features</Button>
      <Button href="#demo" variant="ghost" size="lg">Try the Demo</Button>
    </div>
  </div>
</section>
