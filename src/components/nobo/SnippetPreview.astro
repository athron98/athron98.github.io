---
import { ECOSYSTEM_DOMAINS } from '@lib/constants';

const anchor =
  ECOSYSTEM_DOMAINS.find((d) => d.domain.includes('nobo'))?.anchorTexts[0] ?? 'Nobo note-taking app';
---

<section class="bg-[#27272a] py-16" aria-labelledby="preview-heading">
  <div class="container max-w-3xl">
    <h2 id="preview-heading" class="text-2xl font-bold text-zinc-50">What does it look like?</h2>
    <p class="mt-2 text-sm text-zinc-400">
      A compact board full of code snippets ready to copy back into your terminal —
      <a href="https://nobo.bl8x.my.id" class="text-teal-400 underline-offset-2 hover:underline">{anchor}</a>.
    </p>
    <div class="mt-6 overflow-hidden rounded-xl border border-zinc-700 bg-[#18181b]">
      <div class="flex items-center gap-1.5 border-b border-zinc-700 px-4 py-2.5">
        <span class="h-3 w-3 rounded-full bg-zinc-600" aria-hidden="true"></span>
        <span class="h-3 w-3 rounded-full bg-zinc-600" aria-hidden="true"></span>
        <span class="h-3 w-3 rounded-full bg-zinc-600" aria-hidden="true"></span>
        <span class="ml-2 text-xs text-zinc-500">nobo · board: dev-tools</span>
      </div>
      <pre class="overflow-x-auto p-4 font-mono text-sm leading-relaxed"><code><span class="text-zinc-500"># save a new snippet</span>
<span class="text-purple-400">nobo</span> <span class="text-teal-300">add</span> <span class="text-green-300">"rsync deploy"</span> <span class="text-zinc-300">"rsync -avz ./dist/ user@host:/var/www/"</span>

<span class="text-zinc-500"># recall it when needed</span>
<span class="text-purple-400">nobo</span> <span class="text-teal-300">get</span> <span class="text-green-300">"rsync deploy"</span> <span class="text-zinc-500">|</span> <span class="text-blue-400">sh</span></code></pre>
    </div>
  </div>
</section>
