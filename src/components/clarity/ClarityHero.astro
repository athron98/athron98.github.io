---
import Button from '@components/shared/Button.astro';
---

<section class="bg-gradient-to-b from-clarity-50 to-white">
  <div class="container flex flex-col items-center py-20 text-center sm:py-28">
    <p class="rounded-full bg-clarity-100 px-4 py-1 text-sm font-medium text-clarity-700">Open Source Framework</p>
    <h1 class="mt-6 max-w-3xl text-4xl font-bold tracking-tight text-clarity-900 sm:text-5xl">
      Clarity — build scalable apps with zero configuration
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-clarity-800/80">
      Automatic routing, type-safe APIs, and blazing-fast performance. Everything you need to get started, without
      the complicated setup.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/clarity/docs/" variant="primary" size="lg">Get Started</Button>
      <Button href="#features" variant="secondary" size="lg">View Features</Button>
    </div>
  </div>
</section>
