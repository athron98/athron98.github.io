---
import Button from '@components/shared/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-b from-clarity-50 to-white dark:from-gray-900 dark:to-gray-950">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-20 left-[15%] h-72 w-72 rounded-full bg-sky-400/20 blur-3xl animate-float dark:bg-sky-500/15"></div>
    <div class="absolute bottom-0 right-[10%] h-64 w-64 rounded-full bg-emerald-400/15 blur-3xl animate-float-slow dark:bg-emerald-500/10"></div>
  </div>

  <div class="container relative flex flex-col items-center py-20 text-center sm:py-28">
    <p
      data-reveal
      class="rounded-full border border-clarity-200 bg-white/70 px-4 py-1 text-sm font-medium text-clarity-700 backdrop-blur dark:border-sky-500/30 dark:bg-gray-900/60 dark:text-sky-300"
    >
      Open Source Framework
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 60ms"
      class="mt-6 max-w-3xl bg-gradient-to-r from-sky-500 via-cyan-500 to-emerald-500 bg-clip-text text-4xl font-bold tracking-tight text-transparent animate-gradient-x sm:text-5xl dark:from-sky-300 dark:via-cyan-300 dark:to-emerald-300"
    >
      Clarity — build scalable apps with zero configuration
    </h1>
    <p data-reveal style="--reveal-delay: 120ms" class="mt-6 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
      Automatic routing, type-safe APIs, and blazing-fast performance. Everything you need to get started, without
      the complicated setup.
    </p>
    <div data-reveal style="--reveal-delay: 180ms" class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/clarity/docs/" variant="primary" size="lg">Get Started</Button>
      <Button href="#features" variant="secondary" size="lg">View Features</Button>
    </div>
  </div>
</section>
