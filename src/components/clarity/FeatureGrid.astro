---
interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features?: Feature[];
}

const { features = [
  {
    icon: '⚡',
    title: 'Zero-config routing',
    description: 'Your file structure is your route. No extra configuration required.',
  },
  {
    icon: '🛡️',
    title: 'Type-safe API',
    description: 'Schemas and handlers are fully validated by TypeScript from end to end.',
  },
  {
    icon: '🚀',
    title: 'Blazing-fast',
    description: 'Static output by default with an optimized production runtime.',
  },
  {
    icon: '🧩',
    title: 'Component ecosystem',
    description: 'Reusable components you can compose to build UIs quickly.',
  },
] } = Astro.props;
---

<section id="features" class="bg-white py-16 dark:bg-gray-950" aria-labelledby="features-heading">
  <div class="container">
    <h2 id="features-heading" data-reveal class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">Key features</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature, i) => (
          <div
            data-reveal
            style={`--reveal-delay: ${i * 70}ms`}
            class="group rounded-md border border-clarity-100 bg-clarity-50 p-6 transition-all duration-200 ease-out hover:-translate-y-1 hover:border-gray-300 hover:shadow-card-hover dark:border-gray-800 dark:bg-gray-900 dark:hover:border-gray-700"
          >
            <span class="inline-block text-2xl transition-transform duration-300 group-hover:scale-125 group-hover:-rotate-6" aria-hidden="true">{feature.icon}</span>
            <h3 class="mt-3 font-semibold text-gray-900 dark:text-gray-100">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
