---
interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features?: Feature[];
}

const { features = [
  {
    icon: '⚡',
    title: 'Zero-config routing',
    description: 'Your file structure is your route. No extra configuration required.',
  },
  {
    icon: '🛡️',
    title: 'Type-safe API',
    description: 'Schemas and handlers are fully validated by TypeScript from end to end.',
  },
  {
    icon: '🚀',
    title: 'Blazing-fast',
    description: 'Static output by default with an optimized production runtime.',
  },
  {
    icon: '🧩',
    title: 'Component ecosystem',
    description: 'Reusable components you can compose to build UIs quickly.',
  },
] } = Astro.props;
---

<section id="features" class="bg-white py-16" aria-labelledby="features-heading">
  <div class="container">
    <h2 id="features-heading" class="text-3xl font-bold tracking-tight text-clarity-900">Key features</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature) => (
          <div class="rounded-xl border border-clarity-100 bg-clarity-50 p-6">
            <span class="text-2xl" aria-hidden="true">{feature.icon}</span>
            <h3 class="mt-3 font-semibold text-clarity-900">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-clarity-800/80">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
