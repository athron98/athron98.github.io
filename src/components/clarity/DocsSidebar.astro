---
import { getCollection } from 'astro:content';
import { cx } from '@lib/utils';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const guides = docs.filter((doc) => doc.data.group === 'guide');
const api = docs.filter((doc) => doc.data.group === 'api');

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const hrefFor = (id: string) => `/clarity/docs/${id}/`;
const isActive = (id: string) => currentPath === hrefFor(id).replace(/\/$/, '');
---

<aside class="w-full lg:w-64 lg:shrink-0" aria-label="Document list">
  <nav class="space-y-6 text-sm">
    <div>
      <p class="font-semibold uppercase tracking-wider text-clarity-500 dark:text-sky-400">Guides</p>
      <ul class="mt-2 space-y-1 border-l border-clarity-100 dark:border-gray-800">
        {
          guides.map((doc) => (
            <li>
              <a
                href={hrefFor(doc.id)}
                aria-current={isActive(doc.id) ? 'page' : undefined}
                class={cx(
                  '-ml-px block border-l-2 px-3 py-1.5',
                  isActive(doc.id)
                    ? 'border-clarity-500 font-semibold text-clarity-600 dark:border-sky-500 dark:text-sky-400'
                    : 'border-transparent text-gray-600 transition-colors hover:border-clarity-300 hover:text-clarity-600 dark:text-gray-400 dark:hover:border-sky-500/50 dark:hover:text-sky-400'
                )}
              >
                {doc.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wider text-clarity-500 dark:text-sky-400">API Reference</p>
      <ul class="mt-2 space-y-1 border-l border-clarity-100 dark:border-gray-800">
        {
          api.map((doc) => (
            <li>
              <a
                href={hrefFor(doc.id)}
                aria-current={isActive(doc.id) ? 'page' : undefined}
                class={cx(
                  '-ml-px block border-l-2 px-3 py-1.5',
                  isActive(doc.id)
                    ? 'border-clarity-500 font-semibold text-clarity-600 dark:border-sky-500 dark:text-sky-400'
                    : 'border-transparent text-gray-600 transition-colors hover:border-clarity-300 hover:text-clarity-600 dark:text-gray-400 dark:hover:border-sky-500/50 dark:hover:text-sky-400'
                )}
              >
                {doc.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</aside>
