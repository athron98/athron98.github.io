---
import { cx } from '@lib/utils';

interface Props {
  versions?: { label: string; href: string; current?: boolean; disabled?: boolean }[];
}

const {
  versions = [
    { label: 'v1.0 (stable)', href: '/clarity/docs/', current: true },
    { label: 'v0.9 (legacy)', href: '/clarity/docs/', disabled: true },
  ],
} = Astro.props;

const active = versions.find((v) => v.current) ?? versions[0]!;
---

<details class="relative inline-block text-sm">
  <summary
    class={cx(
      'inline-flex cursor-pointer list-none items-center gap-1 rounded-lg border border-clarity-200 bg-white px-3 py-1.5 font-medium text-clarity-800 hover:border-clarity-300',
      '[&::-webkit-details-marker]:hidden'
    )}
  >
    {active.label}
    <span aria-hidden="true">▾</span>
  </summary>
  <ul class="absolute right-0 z-10 mt-1 w-48 overflow-hidden rounded-lg border border-clarity-200 bg-white shadow-lg">
    {
      versions.map((version) => (
        <li>
          {version.disabled ? (
            <span class="block px-3 py-2 text-clarity-300" aria-disabled="true">
              {version.label}
            </span>
          ) : (
            <a href={version.href} class="block px-3 py-2 text-clarity-800 hover:bg-clarity-50">
              {version.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</details>
