---
import CodeBlock from '@components/shared/CodeBlock.astro';
---

<section class="py-16 dark:bg-gray-950" aria-labelledby="install-heading">
  <div class="container max-w-3xl">
    <h2 id="install-heading" data-reveal class="text-2xl font-bold text-gray-900 dark:text-gray-100">Setup in seconds</h2>
    <p data-reveal style="--reveal-delay: 60ms" class="mt-3 text-gray-600 dark:text-gray-400">
      One command, zero configuration. Clarity is ready to run with your favorite runtime.
    </p>
    <div class="mt-6">
      <CodeBlock code="bun add clarity" lang="bash" filename="terminal" />
    </div>
  </div>
</section>
