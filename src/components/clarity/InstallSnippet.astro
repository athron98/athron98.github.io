---
import CodeBlock from '@components/shared/CodeBlock.astro';
---

<section class="py-16" aria-labelledby="install-heading">
  <div class="container max-w-3xl">
    <h2 id="install-heading" class="text-2xl font-bold text-clarity-900">Setup in seconds</h2>
    <p class="mt-3 text-clarity-800/80">
      One command, zero configuration. Clarity is ready to run with your favorite runtime.
    </p>
    <div class="mt-6">
      <CodeBlock code="bun add clarity" lang="bash" filename="terminal" />
    </div>
  </div>
</section>
