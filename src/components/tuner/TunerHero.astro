---
import Button from '@components/shared/Button.astro';
---

<section class="bg-gradient-to-br from-violet-600 via-purple-600 to-fuchsia-600">
  <div class="container flex flex-col items-center py-20 text-center sm:py-28">
    <p class="rounded-full bg-white/15 px-4 py-1 text-sm font-medium text-white">Free · No Ads · Just Open It</p>
    <h1 class="tuner-gradient-title mt-6 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Tuner — perfect pitch for every instrument
    </h1>
    <p class="tuner-gradient-title mt-6 max-w-2xl text-lg text-white/80">
      Real-time pitch detection from your device's microphone. Accurate, fast, and completely ad-free.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="#features" variant="primary" size="lg">View Features</Button>
      <Button href="#instruments" variant="secondary" size="lg">Choose Instrument</Button>
    </div>
  </div>
  <h2 class="sr-only">Digital tuner for musicians</h2>
</section>
