---
const cents = '-5';
---

<section class="bg-white/10 py-14" aria-labelledby="visual-heading">
  <div class="container max-w-2xl text-center">
    <h2 id="visual-heading" class="text-2xl font-bold text-white">Cent-level precision</h2>
    <p class="mt-2 text-sm text-white/80">
      The indicator lights up when the pitch is spot-on, so you can tune with confidence.
    </p>
    <div
      class="mx-auto mt-8 flex h-40 w-72 items-end justify-center rounded-b-full border-4 border-b-0 border-white/40 bg-white/10"
      role="img"
      aria-label={`Tuner meter showing a deviation of ${cents} cents`}
    >
      <div class="mb-6 rounded-lg bg-white/90 px-4 py-2">
        <p class="font-mono text-2xl font-bold text-violet-700">A₄</p>
        <p class="font-mono text-xs text-violet-500">{cents} cents</p>
      </div>
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-widest text-white/60">440.00 Hz · 12-TET</p>
  </div>
</section>
