---
const notes = ['E', 'A', 'D', 'G', 'B', 'E'];
---

<section class="bg-white/10 py-14" aria-labelledby="frequency-heading">
  <div class="container max-w-3xl text-center">
    <h2 id="frequency-heading" class="text-2xl font-bold text-white">Live frequency display</h2>
    <p class="mt-2 text-sm text-white/80">Notes and deviations are shown large enough to read from an arm's length.</p>
    <div class="mt-8 grid grid-cols-3 gap-3 sm:grid-cols-6">
      {
        notes.map((note, i) => (
          <div class="rounded-lg bg-white/10 py-4 ring-1 ring-white/20">
            <p class="font-mono text-xl font-bold text-white">{note}</p>
            <p class="font-mono text-[10px] uppercase tracking-wider text-white/60">string {i + 1}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
