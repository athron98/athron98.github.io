---
interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features?: Feature[];
}

const { features = [
  {
    icon: '🎤',
    title: 'Real-time detection',
    description: 'Pitch is detected straight from the microphone with minimal latency.',
  },
  {
    icon: '🎸',
    title: 'Multi-instrument',
    description: 'Preset profiles for guitar, bass, ukulele, violin, and other stringed instruments.',
  },
  {
    icon: '🎯',
    title: 'Cent-level precision',
    description: 'Deviation is shown in cents so every tuning is truly precise.',
  },
  {
    icon: '📵',
    title: 'Ad-free',
    description: 'Focus on your music with zero distractions while you tune.',
  },
] } = Astro.props;
---

<section id="features" class="bg-white/10 py-16" aria-labelledby="tuner-features-heading">
  <div class="container">
    <h2 id="tuner-features-heading" class="text-3xl font-bold tracking-tight text-white">Tuner Features</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature) => (
          <div class="rounded-xl bg-white/10 p-6 ring-1 ring-white/20">
            <span class="text-2xl" aria-hidden="true">{feature.icon}</span>
            <h3 class="mt-3 font-semibold text-white">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/80">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
