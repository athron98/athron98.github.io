---
import Button from '@components/shared/Button.astro';
---

<section class="bg-gradient-to-b from-gray-50 to-white">
  <div class="container flex flex-col items-center py-20 text-center sm:py-28">
    <p class="rounded-full bg-sky-100 px-4 py-1 text-sm font-medium text-sky-700">Athron98 · BrokenLight</p>
    <h1 class="mt-6 max-w-3xl text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
      One ecosystem, many tools for developers & musicians
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-gray-600">
      The official hub of the Athron98/BrokenLight ecosystem: project showcases, technical documentation, and tools
      for developers, sysadmins, and the indie music community.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="#projects" variant="primary" size="lg">Explore Projects</Button>
      <Button href="/clarity/docs/" variant="secondary" size="lg">Read the Docs</Button>
    </div>
  </div>
</section>
