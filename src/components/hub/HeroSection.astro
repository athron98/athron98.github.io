---
import Button from '@components/shared/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950">
  <!-- Decorative animated background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-24 left-1/2 h-[28rem] w-[28rem] -translate-x-[70%] rounded-full bg-sky-400/20 blur-3xl animate-float dark:bg-sky-500/15"
    >
    </div>
    <div
      class="absolute -top-16 right-0 h-80 w-80 rounded-full bg-fuchsia-400/15 blur-3xl animate-float-slow dark:bg-fuchsia-500/10"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 h-64 w-64 rounded-full bg-amber-300/15 blur-3xl animate-float dark:bg-amber-500/10"
    >
    </div>
  </div>

  <div class="container relative flex flex-col items-center py-20 text-center sm:py-28">
    <p
      data-reveal
      class="rounded-full border border-sky-200 bg-white/70 px-4 py-1 text-sm font-medium text-sky-700 backdrop-blur dark:border-sky-500/30 dark:bg-gray-900/60 dark:text-sky-300"
    >
      Athron98 · BrokenLight
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 60ms"
      class="mt-6 max-w-3xl bg-gradient-to-r from-sky-500 via-indigo-500 to-fuchsia-500 bg-clip-text text-4xl font-bold tracking-tight text-transparent animate-gradient-x sm:text-5xl dark:from-sky-300 dark:via-indigo-300 dark:to-fuchsia-300"
    >
      One ecosystem, many tools for developers & musicians
    </h1>
    <p
      data-reveal
      style="--reveal-delay: 120ms"
      class="mt-6 max-w-2xl text-lg text-gray-600 dark:text-gray-400"
    >
      The official hub of the Athron98/BrokenLight ecosystem: project showcases, technical documentation, and tools
      for developers, sysadmins, and the indie music community.
    </p>
    <div data-reveal style="--reveal-delay: 180ms" class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="#projects" variant="primary" size="lg">Explore Projects</Button>
      <Button href="/clarity/docs/" variant="secondary" size="lg">Read the Docs</Button>
    </div>
  </div>
</section>
