---
import type { ProjectMeta } from '@lib/types';

interface Props {
  project: ProjectMeta;
}

const { project } = Astro.props;
const accent: Record<string, string> = {
  clarity: 'from-sky-500 to-emerald-500',
  nobo: 'from-zinc-700 to-amber-500',
  tuner: 'from-violet-600 to-pink-500',
};
---

<a
  href={project.path}
  class="group block overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
>
  <div class={`h-2 bg-gradient-to-r ${accent[project.id]}`} aria-hidden="true"></div>
  <div class="p-6">
    <h3 class="text-xl font-semibold text-gray-900 group-hover:text-sky-600">{project.name}</h3>
    <p class="mt-1 text-sm font-medium text-gray-500">{project.tagline}</p>
    <p class="mt-3 text-sm leading-relaxed text-gray-600">{project.description}</p>
    <p class="mt-4 text-sm font-semibold text-sky-600">View showcase →</p>
  </div>
</a>
