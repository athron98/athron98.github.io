---
import type { ProjectMeta } from '@lib/types';

interface Props {
  project: ProjectMeta;
  revealDelay?: number;
}

const { project, revealDelay = 0 } = Astro.props;
const accent: Record<string, string> = {
  clarity: 'from-sky-500 to-emerald-500',
  nobo: 'from-zinc-700 to-amber-500',
  tuner: 'from-violet-600 to-pink-500',
};
// Per-project hover identity: tinted border + soft glow in the project's color.
const glow: Record<string, string> = {
  clarity: 'hover:border-sky-300 hover:shadow-glow-sky dark:hover:border-sky-500/50',
  nobo: 'hover:border-amber-300 hover:shadow-glow-amber dark:hover:border-amber-500/50',
  tuner: 'hover:border-fuchsia-300 hover:shadow-glow-pink dark:hover:border-fuchsia-500/50',
};
---

<a
  href={project.path}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
  class={`group block overflow-hidden border border-gray-200 bg-white shadow-card transition-all duration-300 ease-out hover:-translate-y-1.5 dark:border-gray-800 dark:bg-gray-900 ${glow[project.id]}`}
>
  <div class={`h-1.5 bg-gradient-to-r ${accent[project.id]} transition-transform duration-300 group-hover:scale-x-105`} aria-hidden="true"></div>
  <div class="p-6">
    <h3 class="text-xl font-semibold text-gray-900 transition-colors group-hover:text-sky-600 dark:text-gray-100 dark:group-hover:text-sky-400">{project.name}</h3>
    <p class="mt-1 text-sm font-medium text-gray-500 dark:text-gray-400">{project.tagline}</p>
    <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{project.description}</p>
    <p class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-sky-600 dark:text-sky-400">
      View showcase
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
    </p>
  </div>
</a>
