---
import BacklinkCard from '@components/shared/BacklinkCard.astro';
import { ECOSYSTEM_DOMAINS } from '@lib/constants';
---

<section class="bg-white py-16 dark:bg-gray-950" aria-labelledby="ecosystem-heading">
  <div class="container">
    <div data-reveal>
      <h2 id="ecosystem-heading" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
        Ecosystem network
      </h2>
      <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
        Portals, tools, and communities across the Athron98/BrokenLight ecosystem.
      </p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {ECOSYSTEM_DOMAINS.map((domain, i) => <BacklinkCard domain={domain} anchorIndex={i % 3} revealDelay={i * 50} />)}
    </div>
  </div>
</section>
