---
interface Props {
  code: string;
  lang?: string;
  filename?: string;
}

const { code, lang = 'bash', filename } = Astro.props;
---

<figure class="overflow-hidden rounded-xl border border-gray-800 bg-gray-900">
  {
    (filename || lang) && (
      <figcaption class="flex items-center justify-between border-b border-gray-800 px-4 py-2 text-xs text-gray-400">
        <span>{filename ?? lang}</span>
        <span class="uppercase tracking-wider">{lang}</span>
      </figcaption>
    )
  }
  <pre
    class="overflow-x-auto p-4 text-sm leading-relaxed text-gray-100"><code class={`font-mono language-${lang}`}>{code}</code></pre>
</figure>
