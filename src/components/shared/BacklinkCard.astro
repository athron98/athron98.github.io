---
import type { EcosystemDomain } from '@lib/types';

interface Props {
  domain: EcosystemDomain;
  anchorIndex?: number;
}

const { domain, anchorIndex = 0 } = Astro.props;
const anchor = domain.anchorTexts[anchorIndex] ?? domain.anchorTexts[0]!;
---

<a
  href={domain.domain}
  class="group block rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <p class="text-sm font-semibold text-gray-900 group-hover:text-sky-600">{anchor}</p>
  <p class="mt-1 text-xs text-gray-500">{new URL(domain.domain).hostname}</p>
</a>
