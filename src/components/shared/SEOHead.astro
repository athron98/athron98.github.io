---
import { normalizeSeo, pageTitle } from '@lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  robots?: string;
  keywords?: string;
  schema?: Record<string, unknown>[];
}

const props = Astro.props;
const seo = normalizeSeo({
  title: props.title,
  description: props.description,
  canonical: props.canonical ?? Astro.url.pathname,
  ogType: props.ogType,
  ogImage: props.ogImage,
  robots: props.robots,
  schema: props.schema,
  keywords: props.keywords,
});
const schemaObjects = seo.schema ?? [];
---

<title>{pageTitle(seo.title)}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={seo.canonical} />
{seo.keywords && <meta name="keywords" content={seo.keywords} />}

<!-- Search Console & site verification -->
<meta name="google-site-verification" content="s3TPlLK5f1U_KqCgYpKXzmon01qLAF7qphOCFFrtKvg" />

<!-- Performance: faster external resource setup -->
<meta name="theme-color" content="#0ea5e9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#030712" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={seo.ogType} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:site_name" content="Athron98 Ecosystem" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />

{schemaObjects.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
