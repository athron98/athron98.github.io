---
import { cx } from '@lib/utils';

interface Props {
  /** 'dark' = always-dark header for pages with dark backgrounds (nobo/tuner). */
  variant?: 'auto' | 'dark';
}

const { variant = 'auto' } = Astro.props;
const forced = variant === 'dark';

const links = [
  { label: 'Hub', href: '/' },
  { label: 'Clarity', href: '/clarity/' },
  { label: 'Nobo', href: '/nobo/' },
  { label: 'Tuner', href: '/tuner/' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class={cx(
    'sticky top-0 z-40 border-b backdrop-blur-md transition-all duration-300',
    forced
      ? 'border-white/10 bg-[#18181b]/80 text-white'
      : 'border-gray-200 bg-white/80 text-gray-900 dark:border-gray-800 dark:bg-gray-950/80 dark:text-gray-100'
  )}
>
  <div class="container flex h-14 items-center justify-between">
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 transition-transform duration-300 ease-out hover:-translate-y-0.5 active:translate-y-0"
      aria-label="Athron98 Ecosystem — back to home"
    >
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-gradient-to-br from-sky-500 to-indigo-600 text-sm font-bold text-white shadow-sm transition-all duration-300 group-hover:scale-105 group-hover:shadow-glow-sky"
        aria-hidden="true"
      >
        A
      </span>
      <span class="text-sm font-semibold tracking-tight transition-all duration-300 group-hover:drop-shadow-[0_2px_10px_rgba(14,165,233,0.45)]">
        Athron98
        <span class={cx('font-normal', forced ? 'text-white/50' : 'text-gray-400 dark:text-gray-500')}>
          Ecosystem
        </span>
      </span>
      <span
        class="h-px w-0 bg-gradient-to-r from-sky-500 to-indigo-500 transition-all duration-300 ease-out group-hover:w-6"
        aria-hidden="true"
      ></span>
    </a>

    <nav aria-label="Site" class="flex items-center gap-1">
      {
        links.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.href.replace(/\/$/, '') || current === item.href ? 'page' : undefined}
            class={cx(
              'rounded-md px-2.5 py-1.5 text-sm transition-all duration-200 hover:-translate-y-px',
              current === item.href.replace(/\/$/, '') || current === item.href
                ? forced
                  ? 'bg-white/10 font-medium text-white'
                  : 'bg-gray-100 font-medium text-gray-900 dark:bg-gray-800 dark:text-white'
                : cx(
                    'hover:text-gray-900 dark:hover:text-white',
                    forced ? 'text-white/60 hover:bg-white/10 hover:text-white' : 'text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800'
                  )
            )}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
